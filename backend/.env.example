# 이 파일을 복사해서 .env로 저장하고 실제 값을 채우세요. .env는 git에 올리지 않습니다.

ENV=local
SECRET_KEY=change-me-to-a-long-random-string

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=pw1234
DB_NAME=kidsderm

COOKIE_DOMAIN=localhost
FRONTEND_URL=http://localhost:3000

# 소셜 로그인을 실제로 쓰려면 각 콘솔에서 발급받은 값으로 채우세요. 비워두면 소셜 로그인
# 버튼을 눌렀을 때 에러가 나지만, 이메일 회원가입/로그인은 그대로 정상 동작합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
